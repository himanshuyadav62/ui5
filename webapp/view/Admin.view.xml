<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="pscreen.controller.Admin"
>
    <VBox>
        <Table
            id="settingsTable"
            items="{/}"
            growing="true"
            growingThreshold="10"
        >
            <columns>
                <Column>
                    <Label text="Label" />
                </Column>
                <Column>
                    <Label text="Property" />
                </Column>
                <Column>
                    <Label text="Width" />
                </Column>
                <Column>
                    <Label text="Visible" />
                </Column>
                <Column>
                    <Label text="Order" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Input
                            value="{label}"
                            liveChange="onLabelEdit"
                        />
                        <Text text="{property}" />
                        <Input
                            value="{width}"
                            liveChange="onWidthEdit"
                        />
                        <Switch
                            state="{visible}"
                            change="onVisibilityChange"
                        />
                        <Input
                            value="{order}"
                            type="Number"
                            liveChange="onOrderEdit"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <HBox class="sapUiMediumMargin">
            <Button
                text="Reorder Rows"
                press="onReorderRows"
            />
            <Button
                text="Save Settings"
                press="onSaveSettings"
            />
        </HBox>
    </VBox>
</mvc:View>
